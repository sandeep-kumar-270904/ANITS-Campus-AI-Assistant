# ========================================================
# ANITS AI Assistant - Environment Configuration Template
# Copy this file to backend/.env and populate with your credentials.
# Never commit the actual backend/.env file to version control!
# ========================================================

# Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/college_data?retryWrites=true&w=majority

# Web Security & CORS
FRONTEND_URL=http://localhost:5173
JWT_SECRET=generate_a_secure_32_byte_secret_key_here
ADMIN_PASSWORD=your_secure_admin_password_or_bcrypt_hash
ALLOWED_ADMIN_EMAILS=admin@anits.edu.in,principal@anits.edu.in

# Google Gemini API
GEMINI_API_KEY=your_google_ai_studio_api_key

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_botfather_token

# Google SMTP (For Faculty & Admin Notifications)
GMAIL_ADDRESS=your_college_notifications@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# Twilio Integration (Optional - WhatsApp Gateway)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
